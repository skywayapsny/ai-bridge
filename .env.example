# Server and HTTP agents read process environment variables.
# Copy only the keys needed by each service into its environment.
# AI_BRIDGE_HOST=127.0.0.1
# AI_BRIDGE_PORT=8777
# AI_BRIDGE_QUEUE_DIR=/path/to/private/queue
# AI_BRIDGE_MODEL=ai-bridge
# AI_BRIDGE_MODELS=debug,upstream
# AI_BRIDGE_API_KEY=replace-with-a-client-secret
# AI_BRIDGE_AGENT_KEY=replace-with-a-different-agent-secret
# AI_BRIDGE_TIMEOUT=300
# AI_BRIDGE_POLL_INTERVAL=0.3
# AI_BRIDGE_LEASE_SECONDS=300
# AI_BRIDGE_MAX_INFLIGHT=32
# AI_BRIDGE_REQUIRE_CLAIM=1
# AI_BRIDGE_LOG_LEVEL=info
# AI_BRIDGE_URL=http://127.0.0.1:8777
# AI_BRIDGE_CLIENT_ID=coding-agent

# Worker variables can also be loaded with --env-file.
# AI_WORKER_BASE_URL=https://provider.example/v1
# AI_WORKER_API_KEY=replace-with-an-upstream-key
# AI_WORKER_API_KEYS=first-key,second-key
# AI_WORKER_MODEL=provider-model
# AI_WORKER_CLAIM_MODEL=upstream
# AI_WORKER_TIMEOUT=60
# AI_WORKER_MAX_ATTEMPTS=3
# AI_WORKER_WORKERS=1
# AI_WORKER_THINKING=disabled
# AI_WORKER_REASONING_EFFORT=high
# AI_WORKER_EXTRA_HEADERS={"X-Example":"value"}

# Optional browser adapter
# AI_BROWSER_AQ=127.0.0.1:8778
# AI_BROWSER_SITE=gemini
# AI_BROWSER_MODEL=browser-chat
# AI_BROWSER_BRIDGE=http://127.0.0.1:8777
# AI_BROWSER_TAB=new
# AI_BROWSER_TIMEOUT=240
